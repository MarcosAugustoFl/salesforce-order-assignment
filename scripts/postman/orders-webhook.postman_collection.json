{
  "info": {
    "name": "Orders \u2192 Salesforce webhook",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Sends signed Orders events to the deployed Apex REST endpoint.\n\nSetup: run scripts/postman/make-environment.sh, import the generated environment and this collection, select the environment.\n\nThe collection's pre-request script signs every request automatically (HMAC-SHA256 of the exact body with the shared secret), so you can edit bodies freely."
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// 1. A fresh event id for bodies that use {{eventId}} (so custom events are never accidental duplicates).",
          "pm.variables.set('eventId', 'evt_live_' + Date.now());",
          "// 2. Sign the exact bytes that will be sent: hex(HMAC-SHA256(body, shared secret)).",
          "const body = pm.variables.replaceIn(pm.request.body ? pm.request.body.raw : '');",
          "const secret = pm.variables.get('webhookSecret');",
          "pm.request.headers.upsert({ key: 'Orders-Signature', value: CryptoJS.HmacSHA256(body, secret).toString(CryptoJS.enc.Hex) });"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "webhookSecret",
      "value": "orders-takehome-2026",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Sample sequence (run in order on a clean org)",
      "item": [
        {
          "name": "1. evt_001 inProgress",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('outcome is APPLIED', () => pm.expect(pm.response.json().outcome).to.eql('APPLIED'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "description": "Spec sample payload, sent verbatim.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{instanceUrl}}/services/apexrest/orders/events",
              "host": [
                "{{instanceUrl}}"
              ],
              "path": [
                "services",
                "apexrest",
                "orders",
                "events"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"subscriptionId\": \"sub_a1b2c3d4e5f67890abcdef12\",\n  \"event\": {\n    \"id\": \"evt_001\",\n    \"type\": \"order.inProgress\",\n    \"occurredAt\": \"2026-10-10T10:00:00Z\",\n    \"version\": \"1.0\"\n  },\n  \"data\": {\n    \"orderId\": \"ord_77d1e9\",\n    \"orderFriendlyId\": \"OR-261001-017-2231\",\n    \"accountId\": \"acct_8f3c2a\",\n    \"accountFriendlyId\": \"AC-260914-017-2231\"\n  }\n}",
              "options": {
