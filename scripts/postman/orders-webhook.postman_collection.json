        {
          "name": "Forged signature (expect 401)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Runs after the collection script: overwrite the correct signature with one made from the wrong secret.",
                  "const body = pm.variables.replaceIn(pm.request.body.raw);",
                  "pm.request.headers.upsert({ key: 'Orders-Signature', value: CryptoJS.HmacSHA256(body, 'not-the-secret').toString(CryptoJS.enc.Hex) });"
                ]
              }
            },
