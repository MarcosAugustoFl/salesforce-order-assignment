          "name": "Custom event (edit me)",
          "event": [],
          "request": {
            "method": "POST",
            "description": "Edit type, occurredAt, orderId or accountId and press Send. {{eventId}} becomes a new unique id on every send; replace it with a fixed id (e.g. evt_004) to test duplicates.",
